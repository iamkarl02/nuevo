<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minecraft Mob Editor Pro</title>
    <style>
        :root {
            --primary: #3c8527; /* Grass Green */
            --primary-hover: #2e6b1f;
            --secondary: #313233; /* Stone Gray */
            --accent: #55acee; /* Sky Blue */
            --danger: #be3232; /* TNT Red */
            --bg: #e3e6e9;
            --card-bg: #ffffff;
            --text: #2c3e50;
            --border: #d1d8e0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            padding: 20px;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }
        
        h1 {
            text-align: center;
            margin-bottom: 30px;
            color: var(--secondary);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-bottom: 4px solid var(--primary);
            display: inline-block;
            left: 50%;
            transform: translateX(-50%);
            position: relative;
            padding-bottom: 5px;
        }

        h4 {
            color: var(--secondary);
            border-left: 4px solid var(--primary);
            padding-left: 10px;
            margin: 15px 0 10px 0;
            font-size: 0.95rem;
            text-transform: uppercase;
        }
        
        /* Botones Estilizados */
        button {
            padding: 10px 18px;
            margin: 5px;
            background: var(--secondary);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        button:hover {
            filter: brightness(1.2);
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        button:active {
            transform: translateY(0);
        }

        button.add { background: var(--primary); }
        button.delete { background: var(--danger); }
        button#export-config { background: var(--accent); }
        button#download-config { background: #f39c12; }

        /* Controles Superiores */
        .top-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-bottom: 25px;
            flex-wrap: wrap;
        }
        
        .controls {
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Contenedor de Variables */
        .variables-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .variable {
            background: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border: 1px solid var(--border);
            transition: transform 0.2s ease;
        }

        .variable-header {
            padding: 15px 20px;
            background: #f8f9fa;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            border-bottom: 1px solid var(--border);
        }

        .variable-header:hover {
            background: #f1f2f6;
        }
        
        .variable-content {
            padding: 20px;
            display: none;
            background: #fff;
            animation: fadeIn 0.3s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .variable-content.open { display: block; }

        /* Secciones Internas */
        .section {
            background: #fcfcfc;
            margin: 15px 0;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #edf2f7;
        }
        
        .row {
            margin: 10px 0;
            display: flex;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }
        
        label {
            min-width: 140px;
            font-weight: 700;
            color: #4a5568;
            font-size: 0.85rem;
        }
        
        input, select {
            padding: 8px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            outline: none;
            transition: border-color 0.2s;
            font-size: 14px;
        }

        input:focus {
            border-color: var(--accent);
        }

        /* Mob Sections Grid */
        .mob-sections {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        /* Badges */
        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            margin-left: 10px;
        }
        .status-badge.yes { background: #d4edda; color: #155724; }
        .status-badge.no { background: #f8d7da; color: #721c24; }

        /* Color Picker */
        .color-picker {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
            padding: 10px 0;
        }
        
        .color-option {
            width: 24px;
            height: 24px;
            border-radius: 4px;
            cursor: pointer;
            border: 2px solid rgba(0,0,0,0.1);
            transition: transform 0.1s;
        }
        
        .color-option:hover { transform: scale(1.2); }

        /* Responsive */
        @media (max-width: 768px) {
            .mob-sections { grid-template-columns: 1fr; }
            .row { flex-direction: column; align-items: flex-start; gap: 5px; }
            label { min-width: 100%; }
            input { width: 100%; }
        }

        /* Estilo para las flechas de colapso */
        .variable-header::after {
            content: '▼';
            font-size: 12px;
            color: #a0aec0;
            transition: transform 0.3s;
        }
        .variable-header.expanded::after {
            transform: rotate(180deg);
        }
        
        .nav-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .page-controls {
            margin-top: 30px;
            background: var(--secondary);
            padding: 15px;
            border-radius: 12px;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Minecraft Mob Editor</h1>
        
        <div class="top-buttons">
            <button id="export-config" title="Exportar JSON">📤 Exportar JSON</button>
            <button id="import-config" title="Importar JSON">📥 Importar JSON</button>
            <button id="download-config" title="Descargar .mcfunction">💾 Descargar .mcfunction</button>
        </div>
        
        <div class="controls">
            <div>
                <button id="add-variable" class="add">✚ Añadir Nueva Variable</button>
            </div>
            <div id="variable-count" style="font-weight: bold; color: var(--primary);">Variables: 1/100</div>
        </div>
        
        <div id="variables-container" class="variables-container">
            </div>
        
        <div class="page-controls">
            <button id="prev-page" class="nav-btn">⬅ Anterior</button>
            <span class="page-info" id="page-info">Página 1 de 1</span>
            <button id="next-page" class="nav-btn">Siguiente ➡</button>
        </div>
    </div>

    <script>
        /* [EL RESTO DE TU LÓGICA DE JAVASCRIPT SE MANTIENE EXACTAMENTE IGUAL] */
        /* Asegúrate de pegar todo el bloque <script> que tenías originalmente aquí */
        /* He mantenido los IDs y clases para que todas tus funciones sigan funcionando al 100% */
        
        // ... (Tu código JS anterior aquí)
    </script>
</body>
</html>
